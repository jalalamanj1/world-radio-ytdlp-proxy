# World Radio yt-dlp proxy + bgutil PO-token provider, in one container.
#
# YouTube will not hand out media URLs to a datacenter IP (like Render's) unless
# the request carries BOTH:
#   * cookies        -> mounted by Render as the Secret File /etc/secrets/cookies.txt
#   * a PO token     -> generated by the bgutil provider started below on 127.0.0.1:4416
#
# Neither alone is enough: without cookies yt-dlp gets "Sign in to confirm you're
# not a bot"; with cookies but no PO token the player response comes back with
# storyboards only ("The page needs to be reloaded").
FROM brainicism/bgutil-ytdlp-pot-provider:latest

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && pip3 install --no-cache-dir --break-system-packages -U "yt-dlp[default,curl-cffi]" bgutil-ytdlp-pot-provider

WORKDIR /srv
COPY package.json server.mjs ./

ENV PORT=8080
# TEMP TEST: point at a nonexistent path so the proxy runs with NO cookies, to
# see whether the PO-token provider alone is enough on a datacenter IP.
ENV YTDLP_COOKIES=/nonexistent/cookies.txt
EXPOSE 8080

# Drop the provider image's own ENTRYPOINT; we start both processes ourselves.
ENTRYPOINT []
# Provider on loopback first, then hand the container over to the proxy. yt-dlp
# discovers the provider automatically at http://127.0.0.1:4416.
CMD ["sh", "-c", "node /app/build/main.js --host 127.0.0.1 --port 4416 & exec node /srv/server.mjs"]
